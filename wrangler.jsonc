{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rkn-erp-prod",
  "main": "cloudflare/custom-worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "rkn-erp-auth-prod",
      "database_id": "a52c9cf1-83f1-4fc8-80e0-de6e59c11c6a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RKN_ERP_CORE",
        "class_name": "RknErpCore"
      }
    ]
  },
  "exports": {
    "RknErpCore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
