{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  "name": "rkn-erp-f8c-authenticated-rpc-harness",
  "main": "./src/index.mjs",

  "compatibility_date": "2026-08-14",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "rkn-f8c-local-auth",
      "database_id": "00000000-0000-0000-0000-0000000008c0",
      "preview_database_id": "rkn-f8c-local-auth"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RKN_ERP_CORE",
        "class_name": "RknErpRpcHarness"
      }
    ]
  },

  "exports": {
    "RknErpRpcHarness": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
